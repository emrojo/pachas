# ==============================================================================
# PACHAS - CONFIGURACIÓN DE VARIABLES DE ENTORNO (DOCKER STACK)
# ==============================================================================

# Entorno de ejecución
NODE_ENV=production
PORT=3000

# Nombre del Stack en Docker Swarm
STACK_NAME=pachas

# Tag / Versión de la imagen Docker de la aplicación
PACHAS_IMAGE=pachas:latest

# Número de réplicas para el servicio web en Docker Swarm
APP_REPLICAS=2

# ------------------------------------------------------------------------------
# SUPABASE / BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
# Si utilizas Supabase Cloud o un Supabase autohospedado:
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key_for_development

# ------------------------------------------------------------------------------
# BASE DE DATOS POSTGRESQL (SERVICIOS DEPENDIENTES EN STACK)
# ------------------------------------------------------------------------------
POSTGRES_DB=pachas
POSTGRES_USER=pachas_admin
POSTGRES_PASSWORD=pachas_secure_password_123!
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# REVERSE PROXY / INGRESS (TRAEFIK / CADDY / NGINX)
# ------------------------------------------------------------------------------
APP_DOMAIN=pachas.local
HTTP_PORT=80
HTTPS_PORT=443
