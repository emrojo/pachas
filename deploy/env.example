# ==============================================================================
# PACHAS - CONFIGURACIÓN DE VARIABLES DE ENTORNO (DOCKER STACK / COMPOSE)
# ==============================================================================

# Entorno de ejecución
NODE_ENV=production
PORT=3000

# Nombre del Stack en Docker Swarm
STACK_NAME=pachas

# Tag / Versión de la imagen Docker de la aplicación
PACHAS_IMAGE=pachas:latest

# Número de réplicas para el servicio web en Docker Swarm
APP_REPLICAS=2

# ------------------------------------------------------------------------------
# SUPABASE / BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
# Si utilizas Supabase Cloud o un Supabase autohospedado:
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_production_anon_key

# Email del Administrador Global inicial del sistema
NEXT_PUBLIC_ADMIN_EMAIL=admin@pachas.local

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION FLAGS
# ------------------------------------------------------------------------------
# En producción, debe estar en false para bloquear accesos rápidos y logins simulados
NEXT_PUBLIC_ENABLE_DEMO_USERS=false

# ------------------------------------------------------------------------------
# BASE DE DATOS POSTGRESQL (SERVICIOS DEPENDIENTES EN STACK)
# ------------------------------------------------------------------------------
POSTGRES_DB=pachas
POSTGRES_USER=pachas_admin
POSTGRES_PASSWORD=pachas_secure_password_change_in_production!
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pachas_admin:pachas_secure_password_change_in_production!@localhost:5432/pachas
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long


# ------------------------------------------------------------------------------
# SERVICIO DE CORREO / RECUPERACIÓN DE CONTRASEÑA (SMTP / RESEND / SENDGRID)
# ------------------------------------------------------------------------------
# Opción 1: Servidor SMTP estándar (Gmail, Mailgun, Amazon SES, Postmark, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@tudominio.com
SMTP_PASS=tu_password_smtp_o_app_password
SMTP_FROM="Pachas" <notificaciones@tudominio.com>

# Opción 2: Resend API (Recomendado para Next.js / Serverless)
# RESEND_API_KEY=re_123456789
# EMAIL_FROM=Pachas <onboarding@resend.dev>

# Opción 3: SendGrid API
# SENDGRID_API_KEY=SG.123456789
# EMAIL_FROM=notificaciones@tudominio.com

# ------------------------------------------------------------------------------
# REVERSE PROXY / INGRESS (NGINX / TLS / RATE LIMITING)
# ------------------------------------------------------------------------------
APP_DOMAIN=pachas.local
APP_URL=https://pachas.local
HTTP_PORT=80
HTTPS_PORT=443

# ------------------------------------------------------------------------------
# ESCANEO INTELIGENTE DE TICKETS CON IA DE VISIÓN (GOOGLE GEMINI 1.5 FLASH)
# ------------------------------------------------------------------------------
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey (15 peticiones/min gratis)
# GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# BÚSQUEDA DINÁMICA DE FOTOS DE PORTADA (PEXELS API)
# ------------------------------------------------------------------------------
# Obtén tu clave gratuita en: https://www.pexels.com/api/
# Si se omite, Pachas utiliza de forma automática su catálogo inteligente HD de respaldo.
# PEXELS_API_KEY=your_pexels_api_key_here

# ------------------------------------------------------------------------------
# NOTIFICACIONES PUSH (WEBPUSH VAPID)
# ------------------------------------------------------------------------------
# Genera tus claves con: node deploy/generate-secrets.mjs o npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BLu_...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:notificaciones@pachas.local

# ------------------------------------------------------------------------------
# TIPOS DE CAMBIO HISTÓRICOS Y MONEDAS EXÓTICAS (OPEN EXCHANGE RATES - OPCIONAL)
# ------------------------------------------------------------------------------
# Si se omite, Pachas utiliza la API pública del Banco Central Europeo (Frankfurter API).
# OPEN_EXCHANGE_RATES_APP_ID=your_open_exchange_rates_app_id



