# ==============================================================================
# PACHAS - CONFIGURACIÓN DE VARIABLES DE ENTORNO (DOCKER STACK / COMPOSE)
# ==============================================================================

# Entorno de ejecución
NODE_ENV=production
PORT=3000

# Nombre del Stack en Docker Swarm
STACK_NAME=pachas

# Tag / Versión de la imagen Docker de la aplicación
PACHAS_IMAGE=pachas:latest

# Número de réplicas para el servicio web en Docker Swarm
APP_REPLICAS=2

# ------------------------------------------------------------------------------
# SUPABASE / BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
# Si utilizas Supabase Cloud o un Supabase autohospedado:
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_production_anon_key

# Email del Administrador Global inicial del sistema
NEXT_PUBLIC_ADMIN_EMAIL=admin@pachas.local

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION FLAGS
# ------------------------------------------------------------------------------
# En producción, debe estar en false para bloquear accesos rápidos y logins simulados
NEXT_PUBLIC_ENABLE_DEMO_USERS=false

# ------------------------------------------------------------------------------
# BASE DE DATOS POSTGRESQL (SERVICIOS DEPENDIENTES EN STACK)
# ------------------------------------------------------------------------------
POSTGRES_DB=pachas
POSTGRES_USER=pachas_admin
POSTGRES_PASSWORD=pachas_secure_password_change_in_production!
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pachas_admin:pachas_secure_password_change_in_production!@localhost:5432/pachas
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long


# ------------------------------------------------------------------------------
# REVERSE PROXY / INGRESS (NGINX / TLS / RATE LIMITING)
# ------------------------------------------------------------------------------
APP_DOMAIN=pachas.local
HTTP_PORT=80
HTTPS_PORT=443

