# Supabase URL & Anon Key (Obtén estos valores en tu dashboard de Supabase -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key_for_development

# Email del Administrador Global inicial
NEXT_PUBLIC_ADMIN_EMAIL=admin@pachas.local

# Habilitar usuarios de prueba (true para desarrollo, omitir o false en producción)
NEXT_PUBLIC_ENABLE_DEMO_USERS=true
