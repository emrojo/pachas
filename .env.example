# ==============================================================================
# PACHAS - CONFIGURACIÓN DE VARIABLES DE ENTORNO LOCALES Y PRODUCCIÓN
# ==============================================================================

# URL base de la aplicación (para enlaces de recuperación de contraseña en emails)
APP_URL=http://localhost:3000

# Base de datos PostgreSQL (Opcional en desarrollo local con datos de prueba)
# DATABASE_URL=postgresql://pachas_admin:password@localhost:5432/pachas
# POSTGRES_USER=pachas_admin
# POSTGRES_PASSWORD=password
# POSTGRES_DB=pachas

# Email del Administrador Global inicial
NEXT_PUBLIC_ADMIN_EMAIL=admin@pachas.local

# Habilitar usuarios de prueba (true para desarrollo local, false en producción)
NEXT_PUBLIC_ENABLE_DEMO_USERS=true

# Clave secreta para firma de sesiones JWT
JWT_SECRET=default-pachas-jwt-secret-key-32-chars-long

# ------------------------------------------------------------------------------
# SERVIDOR DE CORREO / RECUPERACIÓN DE CONTRASEÑA (SMTP / RESEND / SENDGRID)
# ------------------------------------------------------------------------------
# Opción A: Servidor SMTP estándar (Gmail, Outlook, Mailgun, Amazon SES, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_app_password
# SMTP_FROM="Pachas" <tu_correo@gmail.com>

# Opción B: Resend API (Recomendado para Next.js / Serverless)
# RESEND_API_KEY=re_123456789
# EMAIL_FROM=Pachas <onboarding@resend.dev>

# Opción C: SendGrid API
# SENDGRID_API_KEY=SG.123456789
# EMAIL_FROM=notificaciones@tudominio.com
